@{
    ViewData["Title"] = "Reserva";
}

<h3 class="mb-3">Generar reserva de habitación</h3>
<div id="alerta" class="alert d-none" role="alert"></div>

<!-- Datos del cliente -->
<div class="card mb-3">
    <div class="card-header">Datos del cliente</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="codCliente">Código</label>
                <input id="codCliente" class="form-control" maxlength="10" />
            </div>
            <div class="col-md-auto">
                <button id="btnBuscarCliente" type="button" class="btn btn-primary">Buscar Cliente</button>
                <button id="btnNuevoCliente" type="button" class="btn btn-outline-secondary">Agregar Cliente</button>
            </div>
            <div class="col-md">
                <label class="form-label" for="nombreCliente">Nombre</label>
                <input id="nombreCliente" class="form-control" readonly />
            </div>
        </div>

        <!-- Flujo alterno: Cliente no existe -->
        <div id="panelNuevoCliente" class="row g-2 mt-2 d-none">
            <div class="col-md-3"><input id="nuevoCodigo" class="form-control" placeholder="Código" maxlength="10" /></div>
            <div class="col-md-4"><input id="nuevoNombres" class="form-control" placeholder="Nombres" /></div>
            <div class="col-md-3"><input id="nuevoApellidos" class="form-control" placeholder="Apellidos" /></div>
            <div class="col-md-2 d-grid"><button id="btnGuardarCliente" type="button" class="btn btn-success">Registrar</button></div>
        </div>
    </div>
</div>

<!-- Datos de la reserva -->
<div class="card mb-3">
    <div class="card-header">Datos de la reserva</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label" for="fechaLlegada">Fecha de llegada</label>
                <input id="fechaLlegada" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="fechaSalida">Fecha de salida</label>
                <input id="fechaSalida" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="cantDias">Cantidad de días</label>
                <input id="cantDias" class="form-control" readonly />
            </div>
        </div>
    </div>
</div>

<!-- Datos de las habitaciones -->
<div class="card mb-3">
    <div class="card-header">Datos de las habitaciones</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label" for="numHabitacion">N.º habitación</label>
                <input id="numHabitacion" class="form-control" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="tipoHab">Tipo</label>
                <input id="tipoHab" class="form-control" readonly />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="costoDia">Costo x día</label>
                <input id="costoDia" class="form-control" readonly />
            </div>
            <div class="col-md-5">
                <label class="form-label" for="huesped">Nombre del huésped</label>
                <input id="huesped" class="form-control" />
            </div>
        </div>
        <div class="mt-3">
            <button id="btnBuscarHab" type="button" class="btn btn-primary">Buscar Habitación</button>
            <button id="btnAgregarHab" type="button" class="btn btn-success">Agregar Habitación</button>
        </div>

        <div id="listaDisponibles" class="table-responsive mt-3 d-none">
            <table class="table table-sm table-hover">
                <thead><tr><th>N.º</th><th>Tipo</th><th>Costo x día</th><th></th></tr></thead>
                <tbody id="tbodyDisponibles"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Detalle de la reserva -->
<div class="card mb-3">
    <div class="card-header">Detalle de la reserva</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-secondary">
                    <tr><th>Número</th><th>Tipo</th><th>Huésped</th><th>Costo diario</th><th>Días</th><th>Monto a pagar</th><th></th></tr>
                </thead>
                <tbody id="tbodyDetalle">
                    <tr><td colspan="7" class="text-center text-muted">Aún no hay habitaciones</td></tr>
                </tbody>
            </table>
        </div>
        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="input-group mb-1"><span class="input-group-text w-50">Sub total</span><input id="subTotal" class="form-control text-end" readonly value="0.00" /></div>
                <div class="input-group mb-1"><span class="input-group-text w-50">IGV (18%)</span><input id="igv" class="form-control text-end" readonly value="0.00" /></div>
                <div class="input-group"><span class="input-group-text w-50">Monto total</span><input id="montoTotal" class="form-control text-end fw-bold" readonly value="0.00" /></div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button id="btnGrabar" type="button" class="btn btn-success btn-lg">Grabar Reserva</button>
    <a href="/" class="btn btn-outline-secondary btn-lg" id="btnSalir">Salir</a>
</div>

@section Scripts {
    <script src="~/js/reserva.js"></script>
}
